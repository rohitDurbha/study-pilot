# Backend settings. Copy this file to .env in the backend folder.

# Free language model providers used by llm.py. Set at least one key.
# Groq is tried first and Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides. The defaults are shown.
# LLM_PROVIDERS=groq,gemini
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# GROQ_REASONING_EFFORT=low
# LLM_TIMEOUT_SECONDS=60
# LLM_PDF_TEXT_LIMIT=60000
