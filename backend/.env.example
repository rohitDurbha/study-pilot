# Backend settings. Copy this file to .env in the backend folder.

# Free language model providers used by llm.py. Set at least one key.
# Groq is tried first and Gemini is the fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional overrides. The defaults are shown.
# LLM_PROVIDERS=groq,gemini
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# GROQ_REASONING_EFFORT=low
# LLM_TIMEOUT_SECONDS=60
# LLM_PDF_TEXT_LIMIT=60000

# Embeddings used by the RAG pipeline (embeddings.py, fastembed with ONNX).
# Optional. The defaults are shown. The model is downloaded on first use.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_CACHE_DIR=
# EMBEDDING_BATCH_SIZE=64

# Web safety settings (web_config.py). The defaults are shown.
# FRONTEND_ORIGIN lists the browser origins allowed by CORS, comma separated.
# FRONTEND_ORIGIN=http://localhost:3000
# MAX_UPLOAD_MB=10
