# Frontend settings. Copy this file to .env.local and fill in what you need.

# Optional URL of an MP4 shown by the demo video component. The original
# 39 MB clip from StudyBuddy.ai is not stored in this repository, so leave
# this empty to hide the video, or point it at a file you host yourself.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Address of the Flask backend. Leave empty for local development, which uses
# http://127.0.0.1:5005. The Vercel deploy sets it to the Hugging Face Space.
NEXT_PUBLIC_BACKEND_URL=
